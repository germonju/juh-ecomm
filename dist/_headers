# Cloudflare Pages — en-têtes HTTP personnalisés.

# Assets buildés par Vite : nom de fichier avec hash (immuable). On les met
# en cache long terme côté navigateur ; le hash change à chaque build donc
# l'invalidation est automatique. Par défaut Cloudflare Pages sert max-age=0.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images : cache moyen terme (mises à jour ponctuelles).
/images/*
  Cache-Control: public, max-age=2592000

# Sécurité (impact SEO indirect — qualité/confiance). En-têtes explicités ici
# plutôt que de dépendre des défauts Cloudflare. Pas de CSP strict : casserait
# GTM/Supabase inline.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
